# Django secret key — generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True for local development, False in production
DEBUG=True

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/yartmatch

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins allowed to make cross-site requests
CORS_ALLOWED_ORIGINS=http://localhost:5173
